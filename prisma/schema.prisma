// prisma/schema.prisma
// Traiteur La Pomme Verte — plateforme de gestion des menus
// Modules couverts : Institution, Repas, Menu

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Institution — CPE, école, garderie, etc. Utilisée à deux endroits :
// (1) chaque Menu appartient à UNE SEULE institution (voir Menu.institution
// plus bas — un même contenu servi à une deuxième institution se fait par
// duplication de menu, pas par partage) et (2) la disponibilité d'un Repas
// (voir Repas.institutions plus bas — liste vide = disponible pour toutes).
// ------------------------------------------------------------------
model Institution {
  id                String   @id @default(cuid())
  nom               String
  logoUrl           String?
  actif             Boolean  @default(true)

  // Adresse
  adresse           String?
  ville             String?
  province          String?  @default("QC")
  codePostal        String?

  // Coordonnées de l'institution
  telephone         String?
  courriel          String?
  siteWeb           String?

  // Personne contact
  personneContact   String?
  telephoneContact  String?
  courrielContact   String?

  // Notes libres
  notes             String?

  // Modes de paiement et formats acceptés — varient réellement d'une
  // institution à l'autre (voir Christine, courriels du 9 août) : certaines
  // écoles ont une entente avec leur fondation, d'autres pas ; certaines
  // offrent un format "Petit repas" (généralement les maternelles),
  // d'autres seulement Régulier/Portion+.
  offreFondation    Boolean  @default(false)
  offreFormatPetit  Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  menus     Menu[]
  repas     Repas[]
  enfants   Enfant[]

  @@map("institutions")
}

// ------------------------------------------------------------------
// Repas — l'inventaire réutilisable. Toute la richesse (photos,
// description, prix par format) vit ici pour ne jamais être
// retapée d'un menu à l'autre.
//
// Photos : une principale + jusqu'à deux additionnelles.
// institutions : liste des institutions pouvant recevoir ce repas —
// vide = disponible pour toutes.
// ------------------------------------------------------------------
model Repas {
  id                  String   @id @default(cuid())
  nom                 String
  description         String?
  photoUrl            String?
  photoUrl2           String?
  photoUrl3           String?
  prixPetit           Decimal  @db.Decimal(6, 2)
  prixRegulier        Decimal  @db.Decimal(6, 2)
  prixDeuxiemeService Decimal  @db.Decimal(6, 2)
  createdAt           DateTime @default(now())

  selections          MenuJourneeSelection[]
  institutions        Institution[]

  @@map("repas")
}

// ------------------------------------------------------------------
// Menu — une période (date de début à date de fin), une thématique,
// une date limite de commande, pour UNE SEULE institution (protection
// structurelle : institutionId est une clé étrangère requise, pas une
// relation n:n — un menu ne peut littéralement pas être lié à deux
// institutions à la fois). Pour servir le même contenu à une autre
// institution, on duplique le menu (voir POST /api/menus/[id]/dupliquer)
// plutôt que de le partager.
//
// Publication : "publie" est l'intention de l'admin ; l'état réellement
// visible au public tient aussi compte de dateLimiteCommande — voir
// estActivementPublie() dans lib/menu-logic.ts. Passé cette date à
// 23h59, le menu redevient invisible même si "publie" est encore vrai,
// pour qu'aucune commande n'entre après la date limite.
// ------------------------------------------------------------------
model Menu {
  id                  String   @id @default(cuid())
  institutionId       String
  periodeDebut        DateTime @db.Date
  periodeFin          DateTime @db.Date
  thematique          String?
  dateLimiteCommande  DateTime @db.Date
  pdfUrl              String?
  publie              Boolean  @default(false)
  createdAt           DateTime @default(now())

  institution         Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  journees            MenuJournee[]
  commandes           Commande[]

  @@map("menus")
}

// ------------------------------------------------------------------
// MenuJournee — une journée (lundi à vendredi) dans la plage du
// menu. Porte de 0 à 2 MenuJourneeSelection (voir plus bas) — une
// journée est complète dès qu'elle en a au moins une.
// ------------------------------------------------------------------
model MenuJournee {
  id                         String   @id @default(cuid())
  menuId                     String
  date                       DateTime @db.Date
  jourSemaine                String   // "Lundi" | "Mardi" | "Mercredi" | "Jeudi" | "Vendredi"

  menu                       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  selections                 MenuJourneeSelection[]
  lignesCommande             LigneCommande[]

  @@unique([menuId, date])
  @@map("menu_journees")
}

// ------------------------------------------------------------------
// MenuJourneeSelection — un choix de repas pour une journée précise.
// Une journée porte jusqu'à 2 sélections (au moins 1 requise pour que
// la journée — et donc le menu — soit considérée complète). Les champs
// *Override permettent d'ajuster nom/description/prix pour CETTE
// occurrence précise SANS modifier le repas maître. Résolution :
//   valeur effective = *Override ?? repas.valeur
// Supprimer une sélection libère le repas — il redevient sélectionnable
// pour cette même journée.
// ------------------------------------------------------------------
model MenuJourneeSelection {
  id                            String   @id @default(cuid())
  journeeId                     String
  repasId                       String

  nomOverride                   String?
  descriptionOverride           String?
  photoUrlOverride              String?
  prixPetitOverride             Decimal? @db.Decimal(6, 2)
  prixRegulierOverride          Decimal? @db.Decimal(6, 2)
  prixDeuxiemeServiceOverride   Decimal? @db.Decimal(6, 2)

  createdAt                     DateTime @default(now())

  journee                       MenuJournee @relation(fields: [journeeId], references: [id], onDelete: Cascade)
  repas                         Repas       @relation(fields: [repasId], references: [id])
  lignesCommande                LigneCommande[]

  @@unique([journeeId, repasId])
  @@map("menu_journee_selections")
}

// ------------------------------------------------------------------
// CompteParent — un parent, identifié par courriel/mot de passe (haché
// PBKDF2, voir lib/parent-auth.ts). Session distincte de l'admin
// (voir lib/parent-session.ts) : ce sont deux mondes séparés, un
// parent ne peut jamais accéder à /admin.
// ------------------------------------------------------------------
model CompteParent {
  id             String   @id @default(cuid())
  courriel       String   @unique
  motDePasseHash String
  nom            String
  telephone      String?
  // Client ayant réglé une entente annuelle directement avec le traiteur —
  // bascule admin (voir /admin/parents) ; quand actif, le checkout de ce
  // parent saute complètement l'étape "mode de paiement" (voir
  // FormulaireCommande.tsx), la commande est enregistrée en PREPAYE.
  prepayeAnnuel  Boolean  @default(false)
  // Préremplit le sélecteur de paiement à la prochaine commande (voir
  // FormulaireCommande.tsx) — pure confort, n'a aucun effet si le parent
  // est prepayeAnnuel (le mode est alors toujours forcé à PREPAYE).
  modePaiementPrefere ModePaiement?
  // Réinitialisation de mot de passe — jeton à usage unique, expire 1h
  // après émission (voir /api/parent/mot-de-passe-oublie et
  // /api/parent/reinitialiser). Sert aussi à "réclamer" un compte-fantôme
  // créé silencieusement par une commande invité (voir
  // commandes-invite/route.ts) : ce compte a un mot de passe aléatoire
  // inutilisable, la réinitialisation est la seule façon d'y accéder.
  resetToken       String?   @unique
  resetTokenExpire DateTime?
  createdAt      DateTime @default(now())

  enfants        Enfant[]
  commandes      Commande[]

  @@map("comptes_parents")
}

// ------------------------------------------------------------------
// Enfant — rattaché à un compte parent ET à une institution précise
// (l'école qu'il fréquente), pour ne proposer que les menus de cette
// institution au moment de commander. Mêmes champs que le formulaire
// papier actuel (niveau, intolérances) pour ne rien perdre à la
// migration.
// ------------------------------------------------------------------
model Enfant {
  id               String   @id @default(cuid())
  compteParentId   String
  institutionId    String
  nomDeFamille     String
  prenom           String
  niveau           String   // "Préscolaire" | "1".."6" | "Adulte"
  intolerances     String[] // sous-ensemble de "Gluten"/"Lactose"/"Végétarien"
  autreIntolerance String?
  createdAt        DateTime @default(now())

  compteParent     CompteParent @relation(fields: [compteParentId], references: [id], onDelete: Cascade)
  institution      Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  commandes        Commande[]

  @@map("enfants")
}

enum ModePaiement {
  ARGENT
  VIREMENT_INTERAC
  CHEQUE
  PAYPAL
  PREPAYE
  FONDATION
}

// ------------------------------------------------------------------
// Commande — la version numérique du coupon-réponse papier : un enfant,
// un menu, un mode de paiement, et une ligne par journée commandée
// (voir LigneCommande). Une seule commande par (enfant, menu) — on la
// MODIFIE plutôt que d'en créer une seconde, comme le permettait déjà
// le coupon (biffer/recocher avant de le remettre).
// ------------------------------------------------------------------
model Commande {
  id             String       @id @default(cuid())
  compteParentId String
  enfantId       String
  menuId         String
  modePaiement   ModePaiement
  paye           Boolean      @default(false)
  payeLe         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  compteParent   CompteParent    @relation(fields: [compteParentId], references: [id], onDelete: Cascade)
  enfant         Enfant          @relation(fields: [enfantId], references: [id], onDelete: Cascade)
  menu           Menu            @relation(fields: [menuId], references: [id], onDelete: Cascade)
  lignes         LigneCommande[]

  @@unique([enfantId, menuId])
  @@map("commandes")
}

enum TailleRepas {
  PETIT
  REGULIER
  DEUXIEME_SERVICE
}

// ------------------------------------------------------------------
// LigneCommande — le choix pour UNE journée : quel repas (parmi les 1
// ou 2 offerts ce jour-là) et quelle taille. Une seule ligne par
// journée par commande — modifier le choix remplace la ligne plutôt
// que d'en ajouter une.
// ------------------------------------------------------------------
model LigneCommande {
  id          String      @id @default(cuid())
  commandeId  String
  journeeId   String
  selectionId String
  taille      TailleRepas

  commande    Commande             @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  journee     MenuJournee          @relation(fields: [journeeId], references: [id], onDelete: Cascade)
  selection   MenuJourneeSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@unique([commandeId, journeeId])
  @@map("lignes_commande")
}

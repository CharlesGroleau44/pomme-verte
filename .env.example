DATABASE_URL="postgresql://user:password@localhost:5432/pomme_verte?schema=public"

# Écran de connexion admin (/login) — protège tout /admin/* et /api/*
ADMIN_USER="admin"
ADMIN_PASSWORD="admin"
SESSION_SECRET="change-moi-en-production"

# Domaine public — utilisé pour construire les liens absolus (ex. le lien
# "Commander en ligne" imprimé sur le PDF du menu). Sans elle, l'app se
# rabat sur l'origine de la requête interne, ce qui casse le lien derrière
# un reverse proxy (Caddy) en production.
SITE_URL="https://pommeverte.charlesgroleau.com"
